# AIC 2026 environment variables
# Copy this file to .env. Generate unique, high-entropy values for both
# required service keys; do not reuse the example file as a credential source.

# Local service authentication (required by docker compose)
QDRANT_API_KEY=
MEILISEARCH_MASTER_KEY=

# Local service endpoints used by application clients
QDRANT_URL=http://127.0.0.1:6333
MEILISEARCH_URL=http://127.0.0.1:7700

# Local Visual Q&A provider. Ollama must remain bound to loopback.
OLLAMA_URL=http://127.0.0.1:11434
OLLAMA_LLM_LIBRARY=vulkan

# Primary single-frame Visual Q&A provider. Keep this key server-side; every
# cloud request also requires explicit frame-transfer consent in the session.
GEMINI_API_KEY=

# Streamlit is a thin client of the sole FastAPI runtime.
AIC_API_URL=http://127.0.0.1:8080

# Runtime profile. The process environment overrides this untracked .env value,
# which overrides config/settings.yaml. Valid values: laptop, accelerated.
AIC_PROFILE=laptop

# Selected competition batch for the canonical launcher and UI defaults.
AIC_BATCH_ID=aic25-b1-reference

CUDA_VISIBLE_DEVICES=0
