# AIC 2026 environment variables
# Copy this file to .env. Generate unique, high-entropy values for both
# required service keys; do not reuse the example file as a credential source.

# Local service authentication (required by docker compose)
QDRANT_API_KEY=
MEILISEARCH_MASTER_KEY=

# Local service endpoints used by application clients
QDRANT_URL=http://127.0.0.1:6333
MEILISEARCH_URL=http://127.0.0.1:7700

# Reserved for future optional model backends. Current stubs do not consume
# these values automatically.
GEMINI_API_KEY=

CUDA_VISIBLE_DEVICES=0
