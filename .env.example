# ═══════════════════════════════════════════════════════════════
# AIC 2026 — Environment Variables
# Copy this file to .env and fill in your values
# ═══════════════════════════════════════════════════════════════

# ── Meilisearch ──
MEILISEARCH_MASTER_KEY=aic2026_dev_key

# ── Google Gemini API (optional, for VLM fallback) ──
GEMINI_API_KEY=

# ── CUDA (override if needed) ──
CUDA_VISIBLE_DEVICES=0
